<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FinalProject"
             x:Class="FinalProject.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Custom Project Colors -->
            <Color x:Key="PrimaryBlue">#2456D8</Color>
            <Color x:Key="DarkBlue">#193F9D</Color>
            <Color x:Key="AccentBlue">#2F6BFF</Color>
            <Color x:Key="AccentGold">#E59A22</Color>
            <Color x:Key="PageBg">#F7F9FC</Color>
            <Color x:Key="CardBg">#FFFFFF</Color>
            <Color x:Key="TextDark">#172033</Color>
            <Color x:Key="TextMuted">#8A9AAF</Color>
            <Color x:Key="BorderLight">#DFE6EF</Color>
            <Color x:Key="SuccessGreen">#16A66A</Color>
            <Color x:Key="LightGreen">#CFF7DF</Color>
            <Color x:Key="DangerRed">#FF496A</Color>
            <Color x:Key="PageBackground">#F7F9FC</Color>
            <Color x:Key="CardBackground">#FFFFFF</Color>
            <Color x:Key="PrimaryText">#172033</Color>
            <Color x:Key="SecondaryText">#8A9AAF</Color>
            <Color x:Key="InputBackground">#FFFFFF</Color>
            <Color x:Key="SurfaceBackground">#FFFFFF</Color>
            <Color x:Key="ElevatedCardBackground">#FFFFFF</Color>
            <Color x:Key="MutedText">#98A2B3</Color>
            <Color x:Key="BorderColor">#E3E8EF</Color>
            <Color x:Key="DividerColor">#EDF1F5</Color>
            <Color x:Key="InputBorder">#E3E8EF</Color>
            <Color x:Key="NavBackground">#FFFFFF</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
