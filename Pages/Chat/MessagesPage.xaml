<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FinalProject.Controls"
             x:Class="FinalProject.MessagesPage"
             BackgroundColor="{DynamicResource PageBg}"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="16,4,16,16" Spacing="14">
                <controls:UniMartHeader/>

                <!-- Title Row -->
                <Grid ColumnDefinitions="*,Auto">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="Chats" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource TextDark}"/>
                        <Border x:Name="ChatCountBadge" BackgroundColor="{DynamicResource InputBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="8,2" VerticalOptions="Center">
                            <Label x:Name="ChatCountLabel" Text="0" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource PrimaryBlue}"/>
                        </Border>
                    </HorizontalStackLayout>
                </Grid>

                <!-- EMPTY STATE VIEW -->
                <Border x:Name="EmptyStateView"
                        IsVisible="False"
                        BackgroundColor="{DynamicResource CardBg}"
                        Stroke="{DynamicResource BorderLight}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Padding="24,32"
                        Margin="0,20,0,0">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Border BackgroundColor="{DynamicResource InputBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 24" HeightRequest="56" WidthRequest="56" HorizontalOptions="Center">
                            <Path Data="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z" Fill="{DynamicResource PrimaryBlue}" Aspect="Uniform" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="No Conversations Yet" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextDark}" HorizontalOptions="Center"/>
                        <Label Text="Tap 'Message Seller' on any campus listing to start chatting and arranging meetups." FontSize="12" TextColor="{DynamicResource TextMuted}" HorizontalTextAlignment="Center" MaximumWidthRequest="260"/>
                    </VerticalStackLayout>
                </Border>

                <!-- DYNAMIC CONVERSATIONS CONTAINER -->
                <VerticalStackLayout x:Name="ConversationsContainer" Spacing="10"/>
            </VerticalStackLayout>
        </ScrollView>
        <controls:BottomNavBar Grid.Row="1" ActiveTab="Messages"/>
    </Grid>
</ContentPage>

