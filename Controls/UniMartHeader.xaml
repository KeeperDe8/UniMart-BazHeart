<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinalProject.Controls.UniMartHeader">
    <Grid ColumnDefinitions="*,Auto,Auto" Padding="2,6,2,8" HeightRequest="56">
        <!-- Logo & Brand Text (BazHeart) -->
        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
            <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="36" WidthRequest="36" Padding="2">
                <Image Source="bazheart_logo.png" Aspect="AspectFit"/>
            </Border>
            <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label Text="Baz" FontSize="21" FontAttributes="Bold" TextColor="{DynamicResource TextDark}"/>
                    <Label Text="Heart" FontSize="21" FontAttributes="Bold" TextColor="{DynamicResource PrimaryBlue}" Margin="-4,0,0,0"/>
                    <Border BackgroundColor="{DynamicResource InputBackground}" Stroke="{DynamicResource BorderLight}" StrokeShape="RoundRectangle 6" Padding="5,2" VerticalOptions="Center">
                        <Label Text="NU LIPA" FontSize="8.5" FontAttributes="Bold" CharacterSpacing="0.8" TextColor="{DynamicResource PrimaryBlue}"/>
                    </Border>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </HorizontalStackLayout>

        <!-- Right Action Buttons (Search & Notifications) -->
        <Grid Grid.Column="1" HeightRequest="38" WidthRequest="38" Margin="0,0,8,0" VerticalOptions="Center">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSearchTapped"/>
            </Grid.GestureRecognizers>
            <Border BackgroundColor="{DynamicResource CardBg}" Stroke="{DynamicResource BorderLight}" StrokeThickness="1" StrokeShape="RoundRectangle 19"
                    Shadow="{OnPlatform Default={Shadow Brush='#000000', Offset='0,2', Radius=8, Opacity=0.08}}">
                <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                      Fill="{DynamicResource TextDark}"
                      Aspect="Uniform"
                      HeightRequest="16"
                      WidthRequest="16"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"/>
            </Border>
        </Grid>

        <Grid Grid.Column="2" HeightRequest="38" WidthRequest="38" VerticalOptions="Center">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMessagesTapped"/>
            </Grid.GestureRecognizers>
            <Border BackgroundColor="{DynamicResource CardBg}" Stroke="{DynamicResource BorderLight}" StrokeThickness="1" StrokeShape="RoundRectangle 19"
                    Shadow="{OnPlatform Default={Shadow Brush='#000000', Offset='0,2', Radius=8, Opacity=0.08}}">
                <Path Data="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"
                      Fill="{DynamicResource TextDark}"
                      Aspect="Uniform"
                      HeightRequest="16"
                      WidthRequest="16"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"/>
            </Border>
            <Ellipse Fill="{DynamicResource DangerRed}" HeightRequest="8" WidthRequest="8" HorizontalOptions="End" VerticalOptions="Start" Margin="0,2,2,0"/>
        </Grid>
    </Grid>
</ContentView>
