<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinalProject.Controls.BottomNavBar">
    <!-- Floating Capsule Navigation Bar with Center '+' Create Listing Action -->
    <Grid Padding="14,4,14,14" BackgroundColor="Transparent">
        <Border BackgroundColor="{DynamicResource CardBg}"
                Stroke="{DynamicResource BorderLight}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 30"
                Shadow="{OnPlatform Default={Shadow Brush='#000000', Offset='0,6', Radius=16, Opacity=0.12}}"
                Padding="6,5"
                HeightRequest="60">
            <Grid ColumnDefinitions="*,*,Auto,*,*">
                <!-- 1. Home Tab -->
                <Border x:Name="HomePill" Grid.Column="0" BackgroundColor="{DynamicResource PrimaryBlue}" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="8,4" HorizontalOptions="Center" VerticalOptions="Center">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnHomeTapped"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center" HorizontalOptions="Center">
                        <Label x:Name="HomeIcon" Text="⌂" FontSize="18" TextColor="White" VerticalOptions="Center"/>
                        <Label x:Name="HomeText" Text="Home" FontSize="11" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- 2. Explore / Category Tab -->
                <Border x:Name="ExplorePill" Grid.Column="1" BackgroundColor="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="8,4" HorizontalOptions="Center" VerticalOptions="Center">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnExploreTapped"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center" HorizontalOptions="Center">
                        <Label x:Name="ExploreIcon" Text="☷" FontSize="17" TextColor="{DynamicResource TextMuted}" VerticalOptions="Center"/>
                        <Label x:Name="ExploreText" Text="Explore" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource TextMuted}" VerticalOptions="Center" IsVisible="False"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- 3. CENTER CREATE LISTING '+' BUTTON (Elevated Motion Primitive Button) -->
                <Grid x:Name="CreateButtonContainer" Grid.Column="2" Padding="4,0" VerticalOptions="Center">
                    <Border x:Name="CreateButton"
                            BackgroundColor="{DynamicResource PrimaryBlue}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 21"
                            HeightRequest="42"
                            WidthRequest="42"
                            Shadow="{OnPlatform Default={Shadow Brush='#2563EB', Offset='0,4', Radius=10, Opacity=0.35}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCreateListingTapped"/>
                        </Border.GestureRecognizers>
                        <Label Text="+"
                               FontSize="25"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Margin="0,-2,0,0"/>
                    </Border>
                </Grid>

                <!-- 4. Messages Tab -->
                <Grid Grid.Column="3" HorizontalOptions="Center" VerticalOptions="Center">
                    <Border x:Name="MessagesPill" BackgroundColor="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="8,4">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnMessagesTapped"/></Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center" HorizontalOptions="Center">
                            <Label x:Name="MessagesIcon" Text="✉" FontSize="17" TextColor="{DynamicResource TextMuted}" VerticalOptions="Center"/>
                            <Label x:Name="MessagesText" Text="Chats" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource TextMuted}" VerticalOptions="Center" IsVisible="False"/>
                        </HorizontalStackLayout>
                    </Border>
                    <Border x:Name="MessageBadge" BackgroundColor="{DynamicResource DangerRed}" StrokeThickness="0" StrokeShape="RoundRectangle 6" HeightRequest="7" WidthRequest="7" HorizontalOptions="End" VerticalOptions="Start" Margin="0,2,4,0"/>
                </Grid>

                <!-- 5. Profile Tab -->
                <Border x:Name="ProfilePill" Grid.Column="4" BackgroundColor="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="8,4" HorizontalOptions="Center" VerticalOptions="Center">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnProfileTapped"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center" HorizontalOptions="Center">
                        <Label x:Name="ProfileIcon" Text="♙" FontSize="18" TextColor="{DynamicResource TextMuted}" VerticalOptions="Center"/>
                        <Label x:Name="ProfileText" Text="Profile" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource TextMuted}" VerticalOptions="Center" IsVisible="False"/>
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Border>
    </Grid>
</ContentView>
